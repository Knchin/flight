# Aircraft Rotation Tracker - Environment Variables
# Copy this to .env.local for local development

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenSky Network (Required for rotation reconstruction)
# Get credentials at https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# AeroDataBox (Recommended for flight lookup)
# Get API key at https://rapid.aerodatabox.com/ or https://apimarket.aerodatabox.com/
AERODATABOX_API_KEY=your-rapidapi-key
AERODATABOX_API_HOST=api.aerodatabox.com

# FlightAware AeroAPI (Optional - deep history, Foresight)
# Get API key at https://www.flightaware.com/aeroapi/signup/personal
FLIGHTAWARE_API_KEY=your-api-key

# AviationStack (Optional - fallback flight lookup)
# Get API key at https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=your-access-key

# ADS-B Exchange (Optional - real-time ADS-B)
# Get API key at https://www.adsbexchange.com/community/developer-hub/
ADSBX_API_KEY=your-api-key

# Feature flags
ENABLE_OPENSKY=true
ENABLE_AERODATABOX=true
ENABLE_FLIGHTAWARE=false
ENABLE_AVIATIONSTACK=false
ENABLE_ADSBEXCHANGE=false