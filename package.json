{
  "name": "aircraft-rotation-tracker",
  "version": "1.0.0",
  "description": "Reconstruct complete daily aircraft rotations from flight numbers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/leaflet": "^1.9.8",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  }
}
